# --- Required: Gemini API key (get one at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Optional ---
# Hugging Face token: avoids anonymous rate limits when downloading the embedding model.
# HF_TOKEN=

# Retrieval tuning
# TOP_K=4
# CANDIDATE_K=12
# CHUNK_SIZE=220
# CHUNK_OVERLAP=40

# Conversation
# MAX_HISTORY_TURNS=6
# TEMPERATURE=0.6
# MAX_OUTPUT_TOKENS=512

# Startup
# BUILD_INDEX_ON_START=true
# WARMUP_ON_START=true
